{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "parse config",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/config/parse.py",
			"cwd": "${workspaceFolder}/config/",
			"console": "integratedTerminal",
			"args": [
			],
			"justMyCode": true,
		},
		{
			"name": "(lldb) server",
			"type": "lldb",
			"request": "launch",
			"program": "${workspaceFolder}/server/build/BoardGames",
			"args": [],
			"cwd": "${workspaceFolder}/server",
			"preLaunchTask": "build BoardGames",
			"stopOnEntry": false
		},
		{
			"name": "flutter app",
			"type": "dart",
			"request": "launch",
			"program": "${workspaceFolder}/app/lib/main.dart",
			"cwd": "${workspaceFolder}/app",
			"toolArgs": [
				"--dart-define=APP_LOG_DIR=${workspaceFolder}/app/logs"
			]
		},
	]
}
