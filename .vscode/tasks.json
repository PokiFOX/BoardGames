{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build BoardGames",
			"type": "shell",
			"command": "./build.sh",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "build",
				"default": true
			},
			"problemMatcher": "$gcc"
		},
		{
			"label": "rebuild BoardGames",
			"type": "shell",
			"command": "./build.sh rebuild",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"problemMatcher": "$gcc"
		}
	]
}
